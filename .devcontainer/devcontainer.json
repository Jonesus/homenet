// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/kubernetes-helm
{
	"name": "Homelab",
	"build": { "dockerfile": "Dockerfile", "context": ".." },

	"features": {
		"ghcr.io/devcontainers-extra/features/opentofu:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},

		"ghcr.io/va-h/devcontainers-features/difftastic:1": {},
		"ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {
		  "jqVersion": "latest",
		  "yqVersion": "latest"
		},

		"ghcr.io/devcontainers-extra/features/sops:1": {},
		"ghcr.io/devcontainers-extra/features/age:1": { "version": "v1.1.1" },
		"ghcr.io/devcontainers-extra/features/age-keygen:1": { "version": "v1.1.1" }
	},

	"runArgs": [
		"--network=host"
	],

	"mounts": [
		// Mount bash aliases
		{
			"source": "${env:HOME}${env:USERPROFILE}/.bash_aliases",
			"target": "/home/vscode/.bash_aliases",
			"type": "bind"
		},
		// bash history
		"source=homenet-bashhistory,target=/commandhistory"
	],

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"gamunu.opentofu",
				"usernamehw.errorlens",
				"eamodio.gitlens",
				"anthropic.claude-code"
			]
		}
	}
}
